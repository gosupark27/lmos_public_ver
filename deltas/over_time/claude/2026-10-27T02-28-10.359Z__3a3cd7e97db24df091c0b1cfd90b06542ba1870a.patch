+
+export function archName(a) {
+  return ARCHETYPES[a] ? ARCHETYPES[a].name : '';
+}
+
+export function emblemEl(characterId, cls) {
+  return svg(EMBLEMS[characterId] || EMBLEMS.surveyor, cls);
