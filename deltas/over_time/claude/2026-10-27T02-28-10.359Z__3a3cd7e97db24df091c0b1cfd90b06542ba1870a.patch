+function scanKeys(obj, path, hits) {
+  if (!obj || typeof obj !== 'object') return;
+  for (const [k, v] of Object.entries(obj)) {
+    if (FORBIDDEN_KEYS.includes(k)) hits.push(path + '.' + k);
+    scanKeys(v, path + '.' + k, hits);
+  }
