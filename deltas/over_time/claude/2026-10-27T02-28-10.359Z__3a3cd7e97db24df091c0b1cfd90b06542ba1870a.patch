+  const dec = h('button', { type: 'button', 'aria-label': `Less ${label || ''}`.trim(), onclick: () => onChange(Math.max(min, value - 1)) }, '−');
+  const inc = h('button', { type: 'button', 'aria-label': `More ${label || ''}`.trim(), onclick: () => onChange(Math.min(max, value + 1)) }, '+');
