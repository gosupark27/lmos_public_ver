-      // Exited mid-scan, or owned by another user.
-      continue;
-    }
-    for (const fd of fds) {
-      try {
-        if (targets.has(readlinkSync(`/proc/${pid}/fd/${fd}`))) {
-          pids.push(pid);
-          break;
-        }
-      } catch {
-        // fd closed mid-scan.
-      }
