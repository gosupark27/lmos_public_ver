+    if (!j.token) throw new Error(j.err || 'no room');
+    store.set(`hs:tok:${j.code}`, j.token);
+    history.pushState(null, '', `/r/${j.code}`);
+    joinTable(j.code, j.token);
+  } catch {
+    toast('Couldn’t open a table. Check that the server is running.', true);
+  }
