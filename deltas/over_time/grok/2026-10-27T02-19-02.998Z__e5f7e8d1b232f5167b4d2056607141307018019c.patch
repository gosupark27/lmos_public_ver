+  if (description) {
+    tags.push(`<meta property="og:description" content="${escapeHtml(description)}">`);
+  }
+  if (String(site.type ?? "").toLowerCase() === "x:game") {
+    tags.push(`<meta property="og:type" content="x:game">`);
+  }
