+  const snapFn = useServerFn(snapshot);
+  const configFn = useServerFn(configure);
+  const startFn = useServerFn(start);
+  const actFn = useServerFn(act);
+  const awayFn = useServerFn(away);
+  const closeFn = useServerFn(closeRoom);
