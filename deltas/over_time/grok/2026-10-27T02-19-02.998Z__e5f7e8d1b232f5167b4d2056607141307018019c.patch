+  const kind = (raw as { kind?: unknown }).kind;
+  const rec = raw as Record<string, unknown>;
+  switch (kind) {
+    case "sunrise":
+    case "still":
+    case "confess":
+    case "quiet":
+      return { kind };
+    case "found":
+      if (typeof rec.line !== "string") throw new Error("Bad request.");
