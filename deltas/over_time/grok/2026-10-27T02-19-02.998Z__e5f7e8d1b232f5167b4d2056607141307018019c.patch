+      return { kind: "sacrifice", resource: rec.resource };
+    case "trade":
+      if (!isResource(rec.resource) || typeof rec.to !== "string") throw new Error("Bad request.");
+      return { kind: "trade", to: rec.to, resource: rec.resource };
+    case "accuse":
+    case "boundary":
+    case "peek":
