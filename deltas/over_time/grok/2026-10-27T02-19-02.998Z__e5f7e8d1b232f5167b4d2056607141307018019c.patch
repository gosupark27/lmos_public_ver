+    !path.startsWith("/__grok/") &&
+    !path.startsWith("/api/") &&
+    !path.startsWith("/@") &&
+    !path.startsWith("/node_modules") &&
+    !/\.[a-z0-9]+$/i.test(path)
+  );
+}
+
+export function acceptsHtml(accept) {
+  const value = String(accept ?? "");
+  return value === "" || value.includes("text/html") || value.includes("*/*");
