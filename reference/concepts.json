  ],
  "extra_surfaces": [
    {
      "id": "auth_login_stack",
      "severity": "tension",
      "label": "A login or auth toolkit is in the tree. The spec says no login.",
      "kind": "terms",
      "any": ["better-auth", "sign-in-gate", "email-password", "signin"]
    },
    {
      "id": "grok_pwa_harness",
      "severity": "harness",
      "label": "Grok PWA install shell is in the tree.",
      "kind": "terms",
      "any": ["grok-pwa", "__grok", "virtual-grok"]
    },
    {
      "id": "preview_host_bridge",
      "severity": "harness",
      "label": "Preview-host bridge or path-prefix tooling is in the tree.",
      "kind": "terms",
      "any": ["preview-host-bridge", "preview-path-prefix", "previewhostbridge"]
    },
    {
      "id": "p2p_signaling",
      "severity": "harness",
      "label": "A WebRTC or P2P signaling client is in the tree.",
      "kind": "terms",
      "any": ["rtcpeerconnection", "signaling poll"]
    },
    {
      "id": "bell_sound_shipped",
      "severity": "parked_built",
      "label": "A bell sound ships. The spec parks the bell sound cue.",
      "kind": "terms",
      "any": ["function bell", "export function bell"]
    },
    {
      "id": "docker_fleet",
      "severity": "parked_built",
      "label": "Docker packaging ships. The spec parks Docker fleets.",
      "kind": "terms",
      "any": ["docker-compose", "dockerfile"]
    }
  ]
}
